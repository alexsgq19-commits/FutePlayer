# Variáveis de Ambiente do Servidor de Pagamentos FutePlayer

# Porta em que o servidor Express escuta
PORT=3000

# ID do Projeto Firebase (usado para inicialização padrão do Firestore)
FIREBASE_PROJECT_ID=futeplayer-2b630

# InfiniteTag cadastrada na InfinitePay (sem o símbolo $)
INFINITEPAY_HANDLE=alexsandroguerraqueiroz

# URL pública do backend após hospedar (Render, Railway, Fly.io, etc.)
# Exemplo: https://futeplayer-api.onrender.com
PUBLIC_SERVER_URL=https://seu-servidor.onrender.com

# Opcional: URL explícita do webhook caso seja diferente de $PUBLIC_SERVER_URL/infinitePayWebhook
# INFINITEPAY_WEBHOOK_URL=https://seu-servidor.onrender.com/infinitePayWebhook

# Chave de Conta de Serviço do Firebase (Service Account JSON em formato string ou caminho)
# Para gerar no Firebase Console: Configurações do Projeto -> Contas de Serviço -> Gerar Nova Chave Privada
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"futeplayer-2b630",...}
